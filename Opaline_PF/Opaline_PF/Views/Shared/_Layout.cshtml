@* Layout principal do site: define estrutura HTML compartilhada entre as páginas *@
<!DOCTYPE html>
<html lang="en">
<head>
    @* Define codificação de caracteres e configuração para dispositivos móveis *@
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    @* Título da página: usa ViewData["Title"] definido nas páginas individuais *@
    <title>@ViewData["Title"] - Opaline</title>

    @* Import map vazio (placeholder) para módulos JavaScript se necessário *@
    <script type="importmap"></script>

    @* Estilos CSS: Bootstrap e arquivos de estilo do projeto *@
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/layout.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Opaline_PF.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/7.3.1/css/all.css" integrity="sha512-x9WwyMYBnlXMNQ6kQ/Lyzu1NqIhLQKL5Oq6xByfXuRj7s9CskyCbLv/1IjqzJmXwFXWr0ov6jBV7Qbc0hh9nHg==" crossorigin="anonymous" referrerpolicy="no-referrer">
</head>
<body>
    @* Cabeçalho com barra de navegação (Bootstrap) *@
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm border-bottom navbar-dark box-shadow mb-3 nav-foda">
            <div class="container-fluid">
                @* Link da marca que leva à ação Index do HomeController *@
                <a asp-controller="Home" asp-action="Index">
                    <img style="width: 90px; margin-right: 5px;" src="~/Logo2.png" alt="Início" />
                </a>

                @* Botão para colapsar a navegação em telas pequenas *@
                <button class="navbar-toggler text-white" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon text-white"></span>
                </button>

                @* Itens da barra: links principais e área de login *@
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between links-principais">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            @* Link para a página inicial *@
                            <a class="nav-link cw fs-5 thp" asp-area="" asp-controller="Home" asp-action="Sobre">Sobre Nós</a>
                        </li>
                        <li class="nav-item">
                            @* Link para a página de perfumaria *@
                            <a class="nav-link cw fs-5 thp" asp-area="" asp-controller="Home" asp-action="Perfumes">Perfumaria</a>
                        </li>
                        <li class="nav-item">
                            @* Link para a página de maquiagens *@
                            <a class="nav-link cw fs-5 thp" asp-area="" asp-controller="Home" asp-action="Make">Make</a>
                        </li>
                        <li class="nav-item">
                            @* Link para a página de maquiagens *@
                            <a class="nav-link cw fs-5 thp" asp-area="" asp-controller="Home" asp-action="Kits">Kits</a>
                        </li>
                    </ul>

                    @* Partial view para login/conta do usuário (mostra login ou nome) *@
                    <partial name="_LoginPartial" />
                </div>
            </div>
        </nav>
    </header>

    @* Conteúdo principal da página: cada View renderiza seu conteúdo aqui *@
    <div class="container" style="min-width: 100vh;">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    @* Rodapé com informações básicas e link para privacidade *@
    <footer class="border-top footer text-muted">
        <div class="fc cw">
            <div class="fc-esq">
                <div class="departamentos">
                    <h3>Departamentos</h3>
                    <a class="fca" asp-area="" asp-controller="Home" asp-action="Index">Loja <i class="fa-regular fa-bookmark"></i></a>
                    <a class="fca" asp-area="" asp-controller="Home" asp-action="Privacy">Política de Privacidade <i class="fa-solid fa-user-lock"></i></a>
                    <a class="fca" asp-area="" asp-controller="Home" asp-action="Devolucao">Trocas & Devoluções <i class="fa-solid fa-left-right"></i></a>
                </div>
                <div class="pagamentos">
                    <h3>Métodos de Pagamento</h3>
                    <img src="~/pag-icons.jpg" />
                </div>
            </div>

            <div class="fc-dir">
                <div class="contatos">
                    <h3>Entre em contato</h3>
                    <div class="ctt-wpp">
                        <a class="fca" href="~/sim/whatsapp_iniciar_conversa_5514994691945.html" target="_blank">
                            <i class="fa-brands fa-whatsapp"></i> +55 (14) 99469-1945
                        </a>
                    </div>
                    <div class="ctt-insta">
                        <a class="fca" href="~/sim/instagram_opaline_store.html" target="_blank">
                            <i class="fa-brands fa-instagram"></i> opaline.store
                        </a> 
                    </div>
                </div>
                <div class="fast-nav">
                    <h3>Navegação Rápida</h3>
                    <a class="fca" href="#">Voltar ao topo <i class="fa-solid fa-arrow-up-long"></i></a>
                    <a class="fca" asp-area="" asp-controller="Home" asp-action="Sobre">Sobre Nós <i class="fa-regular fa-circle-question"></i></a>
                    <a class="fca" asp-area="" asp-controller="Home" asp-action="Perfumes">Perfumaria <i class="fa-solid fa-spray-can-sparkles"></i></a>
                    <a class="fca" asp-area="" asp-controller="Home" asp-action="Make">Make <i class="fa-solid fa-paintbrush"></i></a>
                    <a class="fca" asp-area="" asp-controller="Home" asp-action="Kits">Kits <i class="fa-solid fa-gifts"></i></a>
                </div>
            </div>
        </div>
    </footer>

    @* Scripts JavaScript necessários: jQuery, Bootstrap e scripts do site *@
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @* Se a View quiser adicionar scripts específicos, ela pode usar a seção "Scripts" *@
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
